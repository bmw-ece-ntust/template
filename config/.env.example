# ---------------------------------------------------------------
# rApp / xApp Template — Environment Variables
# Copy this file to .env and fill in the values for your project.
# NEVER commit .env to version control.
# ---------------------------------------------------------------

# --- Platform selection -----------------------------------------
# osc   : Live O-RAN SC Non-RT RIC; pure 3GPP counter names (default).
# ns3   : ns-3 simulation via ns-O-RAN (ns-O-RAN naming Adapter).
# viavi : VIAVI RIC Test / RSG (VIAVI naming Adapter, incl. PEE energy).
# oai   : OpenAirInterface via FlexRIC (OAI naming Adapter).
# ocudu : Linux Foundation OCUDU CU/DU (naming + unit Adapter).
# All platforms speak the same O-RAN SME/ICS transport.
RAPP_PLATFORM=osc

# Optimization strategy (algorithm) selector. Built-in: threshold.
# See controllers.strategies.make_strategy; ML/NIM strategies are wired in code.
RAPP_STRATEGY=threshold

# --- Service identity ------------------------------------------
RAPP_SERVICE_NAME=template-app
RAPP_HOST=0.0.0.0
RAPP_PORT=8080

# --- O-RAN SC Non-RT RIC endpoints (all platforms) -------------
RAPP_SME_BASE_URL=http://nonrtric.nonrtric.svc.cluster.local:8090
RAPP_ICS_BASE_URL=http://nonrtric.nonrtric.svc.cluster.local:8083
RAPP_CALLBACK_URL=http://<this-pod-ip>:8080/r1/callback
RAPP_CELL_ID=o-du-1111/cell-0

# --- IBN contract security -------------------------------------
# HMAC-SHA256 secret shared with the intent issuer.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Expires: rotate annually or on compromise.
RAPP_INTENT_SECRET=<generate-with-command-above>

# --- NVIDIA NIM (NvidiaModelStrategy) --------------------------
# NVIDIA API key for NIM inference endpoints.
# Obtain from: https://build.nvidia.com/
# Expires: check NVIDIA NGC console for key expiry.
NVIDIA_API_KEY=<your-nvidia-api-key>
