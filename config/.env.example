# ---------------------------------------------------------------
# rApp Template — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ---------------------------------------------------------------

# Service configuration
SERVICE_NAME=rapp-template
HOST=0.0.0.0
PORT=8080

# Add your project-specific environment variables below.
# Mark any credential that expires with a renewal deadline note.
# Example:
# SMO_TOKEN=<your-token>         # Expires: monthly — renew via: curl ...
# NONRTRIC_URL=http://smo:9090
